2. SQL Questions: 
How would you identify gaps in dates?
WITH ordered_dates AS (
    SELECT 
        user_id,
        log_date AS curr_date,
        -- Get the date from the previous consecutive row
        LAG(log_date) OVER (PARTITION BY user_id ORDER BY log_date) AS prev_date
    FROM user_logins
)
SELECT 
    user_id,
    prev_date + INTERVAL '1' DAY AS gap_start,
    curr_date - INTERVAL '1' DAY AS gap_end,
    (curr_date - prev_date) - 1 AS missing_days
FROM ordered_dates
-- A gap exists if the difference between consecutive dates is more than 1 day
WHERE (curr_date - prev_date) > 1
ORDER BY user_id, gap_start;

