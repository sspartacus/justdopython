WITH store_monthly_revenue AS (
    SELECT 
        o.store_id,
        s.store_name, -- Assuming a store_name column exists in stores table
        DATE_TRUNC('month', o.order_date) AS revenue_month,
        SUM(o.quantity * p.price) AS total_revenue -- Adjust columns based on your schema
    FROM orders o
    JOIN products p ON o.product_id = p.product_id
    JOIN stores s ON o.store_id = s.store_id
    GROUP BY o.store_id, s.store_name, DATE_TRUNC('month', o.order_date)
),
mom_comparison AS (
    SELECT 
        store_id,
        store_name,
        revenue_month,
        total_revenue AS current_month_revenue,
        LAG(total_revenue) OVER (PARTITION BY store_id ORDER BY revenue_month) AS prev_month_revenue
    FROM store_monthly_revenue
),
revenue_decline AS (
    SELECT 
        store_id,
        store_name,
        revenue_month,
        prev_month_revenue,
        current_month_revenue,
        (prev_month_revenue - current_month_revenue) AS revenue_drop,
        ((current_month_revenue - prev_month_revenue) / NULLIF(prev_month_revenue, 0)) * 100 AS pct_change
    FROM mom_comparison
)
SELECT 
    store_id,
    store_name,
    prev_month_revenue,
    current_month_revenue,
    revenue_drop,
    ROUND(pct_change, 2) AS pct_change
FROM revenue_decline
WHERE revenue_month = DATE_TRUNC('month', CURRENT_DATE) -- Filters for the active/latest month
  AND revenue_drop > 0
ORDER BY revenue_drop DESC;


