Q. 1 Find the total revenue, total quantity sold for each customer 
 Find the total uniques customer, total orders, average order value

WITH cust AS (
    SELECT
        customer_id,
        COUNT(order_id) AS order_count
    FROM levistraussco_lv6dr_orders
    WHERE status = 'completed'
    GROUP BY customer_id
    HAVING COUNT(order_id) >= 2
),

customer_dates AS (
    SELECT
        customer_id,
        MIN(order_date) AS first_order_date,
        MAX(order_date) AS last_order_date
    FROM levistraussco_lv6dr_orders
    WHERE customer_id IN (
        SELECT customer_id
        FROM cust
    )
    AND status = 'completed'
    GROUP BY customer_id
)

SELECT
    customer_id,
    DATEDIFF(last_order_date, first_order_date) AS days_diff
FROM customer_dates;


