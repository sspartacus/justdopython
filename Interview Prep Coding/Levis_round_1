SELECT
    DATE_FORMAT(o.order_date, '%Y-%m-01') AS month,
    COUNT(DISTINCT o.customer_id) AS unique_cust,
    COUNT(DISTINCT o.order_id) AS total_orders,
    SUM(oi.quantity) AS total_units,
    SUM(oi.quantity * oi.unit_price) AS revenue,
    SUM(oi.quantity * oi.unit_price) / SUM(oi.quantity) AS AOV
FROM levistraussco_lv6dr_orders o
LEFT JOIN levistraussco_lv6dr_order_items oi
    ON o.order_id = oi.order_id
WHERE o.status = 'completed'
GROUP BY DATE_FORMAT(o.order_date, '%Y-%m-01')
ORDER BY month;




